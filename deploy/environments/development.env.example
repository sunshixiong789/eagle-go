# 非敏感的开发环境建议值。真实值放在云效 development 变量组，不复制本文件部署。
DEPLOY_ENV=development
EAGLE_BIND_ADDRESS=127.0.0.1
EAGLE_HTTP_PORT=8000
EAGLE_METRICS_PORT=9101
EAGLE_OBSERVABILITY_TRACE_SAMPLE_RATIO=1.0
EAGLE_OBSERVABILITY_LOG_LEVEL=debug

# 以下仅展示键名，必须由云效私密变量提供。
EAGLE_DATABASE_DRIVER=postgres
EAGLE_DATABASE_DSN=
EAGLE_AUTH_ISSUER=
EAGLE_AUTH_AUDIENCE=eagle-api-development
EAGLE_AUTH_SIGNING_KEY_HOST_DIRECTORY=/opt/eagle/secrets/development-jwt
EAGLE_AUTH_ACTIVE_SIGNING_KEY_ID=
EAGLE_AUTH_GOOGLE_ENABLED=false
EAGLE_AUTH_GOOGLE_CLIENT_ID=
EAGLE_AUTH_APPLE_ENABLED=false
EAGLE_AUTH_APPLE_CLIENT_ID=
