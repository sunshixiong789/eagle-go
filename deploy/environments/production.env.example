# 生产 Docker 部署变量示例，真实值放在独立的 eagle-production 云效变量组。
DEPLOY_ENV=production
EAGLE_SERVER_SWAGGER_ENABLED=false
EAGLE_BIND_ADDRESS=127.0.0.1
EAGLE_HTTP_PORT=8000
EAGLE_METRICS_PORT=9101
# 所有环境复用 configs/config.yaml；以下差异在对应云效变量组配置。
EAGLE_OBSERVABILITY_LOG_LEVEL=info
EAGLE_OBSERVABILITY_TRACE_SAMPLE_RATIO=0.05
EAGLE_AUTH_AUDIENCE=eagle-api-production

# 独立生产数据库与账号；DSN 由云效私密变量注入。
EAGLE_DATABASE_DRIVER=postgres
EAGLE_DATABASE_DSN=
EAGLE_AUTH_ISSUER=
EAGLE_AUTH_SIGNING_KEY_HOST_DIRECTORY=/opt/eagle/secrets/production-jwt
EAGLE_AUTH_ACTIVE_SIGNING_KEY_ID=
# 如需覆盖 YAML，可在变量组显式设置 EAGLE_AUTH_* / EAGLE_OBSERVABILITY_*。
