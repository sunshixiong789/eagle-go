# 非敏感的测试环境建议值。真实值放在云效 testing 变量组，不复制本文件部署。
DEPLOY_ENV=testing
EAGLE_BIND_ADDRESS=127.0.0.1
EAGLE_HTTP_PORT=8000
EAGLE_METRICS_PORT=9101
EAGLE_OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
EAGLE_OBSERVABILITY_LOG_LEVEL=info

# 测试环境必须使用独立的数据库、数据库账号、JWT audience 和第三方登录客户端。
EAGLE_DATABASE_DRIVER=postgres
EAGLE_DATABASE_DSN=
EAGLE_AUTH_ISSUER=
EAGLE_AUTH_AUDIENCE=eagle-api-testing
EAGLE_AUTH_SIGNING_SECRET=
EAGLE_AUTH_GOOGLE_ENABLED=false
EAGLE_AUTH_GOOGLE_CLIENT_ID=
EAGLE_AUTH_APPLE_ENABLED=false
EAGLE_AUTH_APPLE_CLIENT_ID=
